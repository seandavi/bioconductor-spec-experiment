{
  "group": "granges-coverage",
  "clauses": {
    "GR.COV.BASIC": "coverage(x) returns an RleList with one Rle per seqlevel (in seqlevel order, names = seqlevels), ignoring strand; length = seqlength when known, else max end (0 if no ranges)",
    "GR.COV.WIDTH": "width (scalar or per-seqlevel vector, named or by position) overrides the per-sequence length; named vectors match by seqlevel",
    "GR.COV.SHIFT": "shift moves ranges before counting; scalar or per-range vector",
    "GR.COV.WEIGHT": "weight is a numeric vector (per range) or the name of a numeric mcols column; integer weights give integer Rles, doubles numeric",
    "GR.COV.EDGE": "empty input, zero-width ranges, unused levels, out-of-bound ranges"
  },
  "fixtures": {
    "si": {"$type": "Seqinfo", "seqnames": ["chr1", "chr2", "chrX", "chrU"], "seqlengths": {"$int": [20, 10, 8, null]},
           "isCircular": [false, false, false, false], "genome": "hg"},
    "g": {"$type": "GRanges", "seqnames": ["chr1", "chr1", "chr2", "chr1", "chrU", "chr2"],
          "start": [2, 4, 1, 15, 3, 9], "width": [5, 3, 4, 3, 4, 0],
          "strand": ["+", "-", "*", "+", "+", "-"], "seqinfo": {"$ref": "si"},
          "mcols": {"$type": "DFrame", "columns": {"score": [1, 2, 3, 4, 5, 6], "w": [0.5, 1.5, 2.5, 0.5, 1.5, 2.5], "tag": ["a", "b", "c", "d", "e", "f"]}}},
    "gn": {"$type": "GRanges", "seqnames": ["a", "a", "b"], "start": [1, 3, 2], "width": [3, 3, 2], "strand": ["+", "-", "+"]},
    "ge": {"$type": "GRanges", "seqnames": {"$chr": []}, "start": {"$int": []}, "width": {"$int": []}, "seqinfo": {"$ref": "si"}},
    "gz": {"$type": "GRanges", "seqnames": ["chr1", "chr2"], "start": [3, 4], "width": [0, 0], "seqinfo": {"$ref": "si"}},
    "goob": {"$type": "GRanges", "seqnames": ["chr1", "chr1"], "start": [18, 1], "width": [10, 5], "seqinfo": {"$ref": "si"}}
  },
  "cases": [
    {"id": "gr.cov.basic", "clause": "GR.COV.BASIC", "op": "coverage", "args": [{"$ref": "g"}], "kwargs": {}},
    {"id": "gr.cov.no-seqlengths", "clause": "GR.COV.BASIC", "op": "coverage", "args": [{"$ref": "gn"}], "kwargs": {}},
    {"id": "gr.cov.ignores-strand", "clause": "GR.COV.BASIC", "op": "coverage", "args": [{"$ref": "gn"}], "kwargs": {}},
    {"id": "gr.cov.width.scalar", "clause": "GR.COV.WIDTH", "op": "coverage", "args": [{"$ref": "g"}], "kwargs": {"width": 12}},
    {"id": "gr.cov.width.named", "clause": "GR.COV.WIDTH", "op": "coverage", "args": [{"$ref": "g"}], "kwargs": {"width": {"$int": [6, 12, 3, 5], "names": ["chr1", "chr2", "chrX", "chrU"]}}},
    {"id": "gr.cov.width.named-reordered", "clause": "GR.COV.WIDTH", "op": "coverage", "args": [{"$ref": "g"}], "kwargs": {"width": {"$int": [5, 3, 12, 6], "names": ["chrU", "chrX", "chr2", "chr1"]}}},
    {"id": "gr.cov.width.unnamed-vector", "clause": "GR.COV.WIDTH", "op": "coverage", "args": [{"$ref": "g"}], "kwargs": {"width": [6, 12, 3, 5]}},
    {"id": "gr.cov.width.no-seqlengths", "clause": "GR.COV.WIDTH", "op": "coverage", "args": [{"$ref": "gn"}], "kwargs": {"width": 8}},
    {"id": "gr.cov.width.too-small", "clause": "GR.COV.WIDTH", "op": "coverage", "args": [{"$ref": "g"}], "kwargs": {"width": 3}},
    {"id": "gr.cov.shift.scalar", "clause": "GR.COV.SHIFT", "op": "coverage", "args": [{"$ref": "g"}], "kwargs": {"shift": 2}},
    {"id": "gr.cov.shift.vector", "clause": "GR.COV.SHIFT", "op": "coverage", "args": [{"$ref": "g"}], "kwargs": {"shift": [0, 1, 2, 0, 0, 0]}},
    {"id": "gr.cov.shift.no-seqlengths", "clause": "GR.COV.SHIFT", "op": "coverage", "args": [{"$ref": "gn"}], "kwargs": {"shift": 3}},
    {"id": "gr.cov.weight.vector-int", "clause": "GR.COV.WEIGHT", "op": "coverage", "args": [{"$ref": "g"}], "kwargs": {"weight": [1, 2, 3, 4, 5, 6]}},
    {"id": "gr.cov.weight.vector-dbl", "clause": "GR.COV.WEIGHT", "op": "coverage", "args": [{"$ref": "g"}], "kwargs": {"weight": [0.5, 1.5, 2.5, 0.5, 1.5, 2.5]}},
    {"id": "gr.cov.weight.column-int", "clause": "GR.COV.WEIGHT", "op": "coverage", "args": [{"$ref": "g"}], "kwargs": {"weight": "score"}},
    {"id": "gr.cov.weight.column-dbl", "clause": "GR.COV.WEIGHT", "op": "coverage", "args": [{"$ref": "g"}], "kwargs": {"weight": "w"}},
    {"id": "gr.cov.weight.column-character", "clause": "GR.COV.WEIGHT", "op": "coverage", "args": [{"$ref": "g"}], "kwargs": {"weight": "tag"}},
    {"id": "gr.cov.weight.scalar", "clause": "GR.COV.WEIGHT", "op": "coverage", "args": [{"$ref": "gn"}], "kwargs": {"weight": 3}},
    {"id": "gr.cov.empty", "clause": "GR.COV.EDGE", "op": "coverage", "args": [{"$ref": "ge"}], "kwargs": {}},
    {"id": "gr.cov.zero-width", "clause": "GR.COV.EDGE", "op": "coverage", "args": [{"$ref": "gz"}], "kwargs": {}},
    {"id": "gr.cov.out-of-bound", "clause": "GR.COV.EDGE", "op": "coverage", "args": [{"$ref": "goob"}], "kwargs": {}}
  ]
}
