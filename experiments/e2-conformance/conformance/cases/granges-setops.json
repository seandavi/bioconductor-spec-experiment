{
  "group": "granges-setops",
  "clauses": {
    "GR.UNION": "union(x, y) = reduce(c(x, y)) per (seqname, strand); ignore.strand=TRUE ignores strand and returns '*'; seqinfo is merged",
    "GR.INTERSECT": "intersect(x, y) is the per-(seqname, strand) intersection of the covered positions; '*' on one side does NOT match '+'/'-' unless ignore.strand=TRUE",
    "GR.SETDIFF": "setdiff(x, y) is the per-(seqname, strand) difference of covered positions; ignore.strand=TRUE ignores strand",
    "GR.SETOPS.SEQINFO": "set operations merge seqinfo of x and y (incompatible seqinfo is an error); results keep the merged levels",
    "GR.SETOPS.EDGE": "empty arguments",
    "GR.PUNION": "punion(x, y) is parallel; pairs must have equal seqnames and compatible strands, else error; fill.gap as for IRanges",
    "GR.PINTERSECT": "pintersect(x, y) is parallel and adds a logical mcols column `hit`: FALSE for pairs on different seqnames or incompatible strands (zero-width range at x's start), TRUE otherwise; drop.nohit.ranges=TRUE removes the FALSE pairs and the column; ignore.strand=TRUE ignores strand",
    "GR.PSETDIFF": "psetdiff(x, y) is parallel; incompatible pairs return x unchanged",
    "GR.PSETOPS.LEN": "punion and psetdiff require equal lengths; pintersect recycles a length-1 y but otherwise requires equal lengths"
  },
  "fixtures": {
    "si": {"$type": "Seqinfo", "seqnames": ["chr1", "chr2"], "seqlengths": {"$int": [1000, 500]}, "genome": "hg"},
    "x": {"$type": "GRanges", "seqnames": ["chr1", "chr1", "chr1", "chr2"], "start": [1, 10, 10, 5], "width": [8, 5, 5, 5],
          "strand": ["+", "+", "-", "*"], "seqinfo": {"$ref": "si"}},
    "y": {"$type": "GRanges", "seqnames": ["chr1", "chr1", "chr2", "chr2"], "start": [5, 12, 5, 8], "width": [8, 5, 5, 5],
          "strand": ["+", "-", "+", "-"], "seqinfo": {"$ref": "si"}},
    "ystar": {"$type": "GRanges", "seqnames": ["chr1", "chr2"], "start": [3, 6], "width": [4, 2],
          "strand": ["*", "*"], "seqinfo": {"$ref": "si"}},
    "y2": {"$type": "GRanges", "seqnames": ["chr2", "chr3"], "start": [1, 1], "width": [3, 3],
          "strand": ["+", "+"], "seqinfo": {"$type": "Seqinfo", "seqnames": ["chr2", "chr3"], "seqlengths": {"$int": [500, 200]}, "genome": "hg"}},
    "ybad": {"$type": "GRanges", "seqnames": ["chr1"], "start": [1], "width": [3],
          "seqinfo": {"$type": "Seqinfo", "seqnames": ["chr1"], "seqlengths": {"$int": [999]}, "genome": "hg"}},
    "e": {"$type": "GRanges", "seqnames": {"$chr": []}, "start": {"$int": []}, "width": {"$int": []}, "seqinfo": {"$ref": "si"}},
    "px": {"$type": "GRanges", "seqnames": ["chr1", "chr1", "chr1", "chr2", "chr1"], "start": [1, 10, 10, 5, 50], "width": [8, 5, 5, 5, 5],
          "strand": ["+", "+", "-", "*", "+"], "seqinfo": {"$ref": "si"}},
    "py": {"$type": "GRanges", "seqnames": ["chr1", "chr1", "chr1", "chr2", "chr2"], "start": [5, 12, 12, 8, 50], "width": [8, 5, 5, 5, 5],
          "strand": ["+", "-", "-", "+", "+"], "seqinfo": {"$ref": "si"}},
    "pone": {"$type": "GRanges", "seqnames": ["chr1"], "start": [3], "width": [4], "strand": ["+"], "seqinfo": {"$ref": "si"}},
    "pnames": {"$type": "GRanges", "seqnames": ["chr1", "chr1"], "start": [1, 10], "width": [8, 5], "strand": ["+", "+"], "names": ["a", "b"], "seqinfo": {"$ref": "si"},
          "mcols": {"$type": "DFrame", "columns": {"s": [1, 2]}}}
  },
