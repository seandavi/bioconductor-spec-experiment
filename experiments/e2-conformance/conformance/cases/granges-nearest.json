{
  "group": "granges-nearest",
  "compare": "hits-query-grouped",
  "clauses": {
    "GR.NEAREST.TIE": "nearest(select='all'): subjects within gap 0 win; otherwise the nearer of the precede/follow candidates wins; on an exact distance tie only the precede side is returned (R quirk)",
    "GR.NEAREST": "nearest(x, subject) considers only subjects on the same seqname and a compatible strand ('*' matches any); overlaps are distance 0; NA if no candidate; ignore.strand=TRUE ignores strand",
    "GR.NEAREST.ALL": "nearest(select='all') returns Hits with every tied candidate",
    "GR.NEAREST.SELF": "nearest(x) with no subject excludes the range itself",
    "GR.PRECEDE": "precede(x, subject) is strand-aware: for '+'/'*' x the subject must start after end(x) on the same seqname with compatible strand; for '-' x it must end before start(x) (direction flips); ignore.strand=TRUE treats all as '+'",
    "GR.FOLLOW": "follow(x, subject) is the mirror of precede: for '+'/'*' the subject ends before start(x); for '-' it starts after end(x)",
    "GR.DISTANCE": "distance(x, y) is parallel; NA when seqnames differ or strands are incompatible ('+' vs '-'); '*' is compatible with anything; ignore.strand=TRUE only checks seqnames; the shorter argument recycles",
    "GR.NEAREST.EMPTY": "empty query or subject"
  },
  "fixtures": {
    "si": {"$type": "Seqinfo", "seqnames": ["chr1", "chr2"], "seqlengths": {"$int": [1000, 500]}, "genome": "hg"},
    "q": {"$type": "GRanges", "seqnames": ["chr1", "chr1", "chr1", "chr2", "chr1", "chr2"], "start": [50, 50, 50, 50, 500, 200],
          "width": [5, 5, 5, 5, 5, 5], "strand": ["+", "-", "*", "+", "+", "-"], "seqinfo": {"$ref": "si"}},
    "s": {"$type": "GRanges", "seqnames": ["chr1", "chr1", "chr1", "chr1", "chr2", "chr2"], "start": [10, 100, 120, 30, 70, 300],
          "width": [5, 5, 5, 5, 5, 5], "strand": ["+", "+", "-", "*", "-", "+"], "seqinfo": {"$ref": "si"}},
    "e": {"$type": "GRanges", "seqnames": {"$chr": []}, "start": {"$int": []}, "width": {"$int": []}, "seqinfo": {"$ref": "si"}},
    "dx": {"$type": "GRanges", "seqnames": ["chr1", "chr1", "chr1", "chr2", "chr1", "chr1"], "start": [10, 10, 10, 10, 10, 10], "width": [5, 5, 5, 5, 5, 5],
           "strand": ["+", "+", "-", "+", "*", "+"], "seqinfo": {"$ref": "si"}},
    "dy": {"$type": "GRanges", "seqnames": ["chr1", "chr1", "chr1", "chr1", "chr1", "chr1"], "start": [20, 20, 20, 20, 20, 12], "width": [5, 5, 5, 5, 5, 5],
           "strand": ["+", "-", "-", "+", "-", "+"], "seqinfo": {"$ref": "si"}},
    "one": {"$type": "GRanges", "seqnames": ["chr1"], "start": [100], "width": [5], "strand": ["+"], "seqinfo": {"$ref": "si"}},
    "names": {"$type": "GRanges", "seqnames": ["chr1"], "start": [100], "width": [5], "strand": ["+"], "names": ["x"], "seqinfo": {"$ref": "si"}},
    "selfx": {"$type": "GRanges", "seqnames": ["chr1", "chr1", "chr1", "chr2"], "start": [10, 30, 200, 10], "width": [5, 5, 5, 5],
           "strand": ["+", "-", "*", "+"], "seqinfo": {"$ref": "si"}},
    "ntx": {"$type": "GRanges", "seqnames": ["chr1"], "start": [20], "width": [2], "strand": ["*"], "seqinfo": {"$ref": "si"}},
    "ntm": {"$type": "GRanges", "seqnames": ["chr1"], "start": [20], "width": [2], "strand": ["-"], "seqinfo": {"$ref": "si"}},
    "nty": {"$type": "GRanges", "seqnames": ["chr1", "chr1", "chr1"], "start": [10, 27, 33], "width": [5, 3, 1], "strand": ["*", "*", "*"], "seqinfo": {"$ref": "si"}}
  },
  "cases": [
    {"id": "gr.nearest.default", "clause": "GR.NEAREST", "op": "nearest", "args": [{"$ref": "q"}, {"$ref": "s"}], "kwargs": {}},
    {"id": "gr.nearest.ignore-strand", "clause": "GR.NEAREST", "op": "nearest", "args": [{"$ref": "q"}, {"$ref": "s"}], "kwargs": {"ignore.strand": true}},
    {"id": "gr.nearest.other-seqname-only", "clause": "GR.NEAREST", "op": "nearest", "args": [{"$ref": "one"}, {"$type": "GRanges", "seqnames": ["chr2"], "start": [100], "width": [5], "strand": ["+"], "seqinfo": {"$ref": "si"}}], "kwargs": {}},
    {"id": "gr.nearest.names-dropped", "clause": "GR.NEAREST", "op": "nearest", "args": [{"$ref": "names"}, {"$ref": "s"}], "kwargs": {}},
    {"id": "gr.nearest.all", "clause": "GR.NEAREST.ALL", "op": "nearest", "args": [{"$ref": "q"}, {"$ref": "s"}], "kwargs": {"select": "all"}},
    {"id": "gr.nearest.all.ignore-strand", "clause": "GR.NEAREST.ALL", "op": "nearest", "args": [{"$ref": "q"}, {"$ref": "s"}], "kwargs": {"select": "all", "ignore.strand": true}},
    {"id": "gr.nearest.self", "clause": "GR.NEAREST.SELF", "op": "nearest", "args": [{"$ref": "selfx"}], "kwargs": {}},
    {"id": "gr.nearest.self.ignore-strand", "clause": "GR.NEAREST.SELF", "op": "nearest", "args": [{"$ref": "selfx"}], "kwargs": {"ignore.strand": true}},
    {"id": "gr.nearest.self.all", "clause": "GR.NEAREST.SELF", "op": "nearest", "args": [{"$ref": "selfx"}], "kwargs": {"select": "all"}},
    {"id": "gr.precede.default", "clause": "GR.PRECEDE", "op": "precede", "args": [{"$ref": "q"}, {"$ref": "s"}], "kwargs": {}},
    {"id": "gr.precede.ignore-strand", "clause": "GR.PRECEDE", "op": "precede", "args": [{"$ref": "q"}, {"$ref": "s"}], "kwargs": {"ignore.strand": true}},
    {"id": "gr.precede.all", "clause": "GR.PRECEDE", "op": "precede", "args": [{"$ref": "q"}, {"$ref": "s"}], "kwargs": {"select": "all"}},
    {"id": "gr.precede.self", "clause": "GR.PRECEDE", "op": "precede", "args": [{"$ref": "selfx"}], "kwargs": {}},
    {"id": "gr.follow.default", "clause": "GR.FOLLOW", "op": "follow", "args": [{"$ref": "q"}, {"$ref": "s"}], "kwargs": {}},
    {"id": "gr.follow.ignore-strand", "clause": "GR.FOLLOW", "op": "follow", "args": [{"$ref": "q"}, {"$ref": "s"}], "kwargs": {"ignore.strand": true}},
    {"id": "gr.follow.all", "clause": "GR.FOLLOW", "op": "follow", "args": [{"$ref": "q"}, {"$ref": "s"}], "kwargs": {"select": "all"}},
    {"id": "gr.follow.self", "clause": "GR.FOLLOW", "op": "follow", "args": [{"$ref": "selfx"}], "kwargs": {}},
    {"id": "gr.distance.default", "clause": "GR.DISTANCE", "op": "distance", "args": [{"$ref": "dx"}, {"$ref": "dy"}], "kwargs": {}},
    {"id": "gr.distance.ignore-strand", "clause": "GR.DISTANCE", "op": "distance", "args": [{"$ref": "dx"}, {"$ref": "dy"}], "kwargs": {"ignore.strand": true}},
    {"id": "gr.distance.self", "clause": "GR.DISTANCE", "op": "distance", "args": [{"$ref": "dx"}, {"$ref": "dx"}], "kwargs": {}},
    {"id": "gr.distance.recycle", "clause": "GR.DISTANCE", "op": "distance", "args": [{"$ref": "dx"}, {"$ref": "one"}], "kwargs": {}},
    {"id": "gr.distance.empty", "clause": "GR.DISTANCE", "op": "distance", "args": [{"$ref": "e"}, {"$ref": "e"}], "kwargs": {}},
    {"id": "gr.nearest.empty-subject", "clause": "GR.NEAREST.EMPTY", "op": "nearest", "args": [{"$ref": "q"}, {"$ref": "e"}], "kwargs": {}},
    {"id": "gr.nearest.empty-query", "clause": "GR.NEAREST.EMPTY", "op": "nearest", "args": [{"$ref": "e"}, {"$ref": "s"}], "kwargs": {}},
    {"id": "gr.precede.empty-subject", "clause": "GR.NEAREST.EMPTY", "op": "precede", "args": [{"$ref": "q"}, {"$ref": "e"}], "kwargs": {}},
    {"id": "gr.follow.empty-subject", "clause": "GR.NEAREST.EMPTY", "op": "follow", "args": [{"$ref": "q"}, {"$ref": "e"}], "kwargs": {}},
    {"id": "gr.nearest.all.empty-subject", "clause": "GR.NEAREST.EMPTY", "op": "nearest", "args": [{"$ref": "q"}, {"$ref": "e"}], "kwargs": {"select": "all"}},
    {"id": "gr.nearest.all.tie-precede-side-only", "clause": "GR.NEAREST.TIE", "op": "nearest", "args": [{"$ref": "ntx"}, {"$ref": "nty"}], "kwargs": {"select": "all"}},
    {"id": "gr.nearest.arbitrary.tie-lower-index", "clause": "GR.NEAREST.TIE", "op": "nearest", "args": [{"$ref": "ntx"}, {"$ref": "nty"}], "kwargs": {}},
    {"id": "gr.nearest.all.tie-minus-strand", "clause": "GR.NEAREST.TIE", "op": "nearest", "args": [{"$ref": "ntm"}, {"$ref": "nty"}], "kwargs": {"select": "all"}},
    {"id": "gr.nearest.all.follow-closer", "clause": "GR.NEAREST.TIE", "op": "nearest", "args": [{"$type": "GRanges", "seqnames": ["chr1"], "start": [18], "width": [2], "strand": ["+"], "seqinfo": {"$ref": "si"}}, {"$ref": "nty"}], "kwargs": {"select": "all"}},
    {"id": "gr.nearest.all.precede-closer", "clause": "GR.NEAREST.TIE", "op": "nearest", "args": [{"$type": "GRanges", "seqnames": ["chr1"], "start": [22], "width": [2], "strand": ["+"], "seqinfo": {"$ref": "si"}}, {"$ref": "nty"}], "kwargs": {"select": "all"}}
  ]
}
