{
  "group": "iranges-intra",
  "clauses": {
    "IR.SHIFT": "shift(x, s) adds s to every start (recycled), keeps width, names and mcols",
    "IR.NARROW": "narrow(x, start, end, width) trims relative to each range (1-based within the range; negative counts from the end); start may be width+1 (empty result); reaching outside the range is an error",
    "IR.RESIZE.START": "resize(x, w, fix='start') keeps start and sets width to w",
    "IR.RESIZE.END": "resize(x, w, fix='end') keeps end and sets width to w",
    "IR.RESIZE.CENTER": "resize(x, w, fix='center') keeps the centre; odd differences round per R",
    "IR.RESIZE.MISC": "resize recycles width and fix, handles zero-width input and target, and use.names=FALSE drops names",
    "IR.FLANK": "flank(x, w) returns the w positions upstream (start=TRUE) or downstream (start=FALSE) of each range; negative w flanks inside; both=TRUE straddles the boundary",
    "IR.PROMOTERS": "promoters(x, upstream, downstream) = range from start - upstream to start + downstream - 1"
  },
