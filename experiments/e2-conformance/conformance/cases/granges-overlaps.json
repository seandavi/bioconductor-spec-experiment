{
  "group": "granges-overlaps",
  "compare": "hits-query-grouped",
  "clauses": {
    "GR.OV.STRAND": "findOverlaps(q, s) requires equal seqnames and compatible strands: '+' matches '+' and '*', '-' matches '-' and '*', '*' matches everything; ignore.strand=TRUE ignores strand",
    "GR.OV.SEQNAME": "ranges on different seqnames never overlap, regardless of coordinates",
    "GR.OV.TYPE": "type any/start/end/within/equal apply the IRanges rule within each compatible (seqname, strand) pair",
    "GR.OV.PARAMS": "maxgap and minoverlap apply as for IRanges within compatible pairs",
    "GR.OV.SELECT": "select='first'/'last' pick the lowest/highest subject index per query among compatible hits, NA otherwise",
    "GR.OV.SEQINFO": "query and subject seqinfo are merged for the comparison: level order may differ; incompatible seqlengths/genomes are errors, disjoint seqlevels warn",
    "GR.OV.COUNT": "countOverlaps(q, s, ...) = per-query hit count; keeps query names",
    "GR.OV.ANYQ": "overlapsAny(q, s, ...) = per-query logical",
    "GR.OV.SUBSET": "subsetByOverlaps(x, ranges, ..., invert, ignore.strand) keeps (or drops) elements of x with a hit, in order, with names/mcols/seqinfo",
    "GR.OV.EMPTY": "empty query or subject gives empty/NA/zero results; Hits records lengths",
    "GR.OV.ZEROWIDTH": "zero-width ranges follow the IRanges zero-width rule within compatible pairs"
  },
  "fixtures": {
    "si": {"$type": "Seqinfo", "seqnames": ["chr1", "chr2", "chrM"], "seqlengths": {"$int": [1000, 500, 16]}, "isCircular": [false, false, true], "genome": "hg"},
    "q": {"$type": "GRanges", "seqnames": ["chr1", "chr1", "chr1", "chr2", "chr2", "chrM", "chr1"], "start": [10, 10, 10, 100, 100, 3, 300], "width": [10, 10, 10, 10, 10, 4, 5], "strand": ["+", "-", "*", "+", "*", "+", "+"], "names": ["a", "b", "c", "d", "e", "f", "g"], "seqinfo": {"$ref": "si"}, "mcols": {"$type": "DFrame", "columns": {"score": [1.5, 2.5, 3.5, 4.5, 5.5, 6.5, 7.5]}}},
    "s": {"$type": "GRanges", "seqnames": ["chr1", "chr1", "chr1", "chr2", "chr2", "chr1", "chrM", "chr1"], "start": [5, 15, 15, 95, 105, 10, 4, 20], "width": [10, 10, 10, 10, 3, 10, 2, 0], "strand": ["+", "-", "*", "-", "*", "+", "+", "+"], "seqinfo": {"$ref": "si"}},
    "sflip": {"$type": "GRanges", "seqnames": ["chr2", "chr1"], "start": [100, 10], "width": [10, 10], "strand": ["+", "+"], "seqinfo": {"$type": "Seqinfo", "seqnames": ["chrX", "chr2", "chr1"], "seqlengths": {"$int": [null, 500, 1000]}, "genome": "hg"}},
    "sdisjoint": {"$type": "GRanges", "seqnames": ["chrA"], "start": [10], "width": [10], "strand": ["+"], "seqinfo": {"$type": "Seqinfo", "seqnames": ["chrA"], "genome": "hg"}},
    "sbad": {"$type": "GRanges", "seqnames": ["chr1"], "start": [10], "width": [10], "strand": ["+"], "seqinfo": {"$type": "Seqinfo", "seqnames": ["chr1"], "seqlengths": {"$int": [999]}, "genome": "hg"}},
    "e": {"$type": "GRanges", "seqnames": {"$chr": []}, "start": {"$int": []}, "width": {"$int": []}, "seqinfo": {"$ref": "si"}},
    "qz": {"$type": "GRanges", "seqnames": ["chr1", "chr1", "chr2", "chr1"], "start": [10, 15, 100, 16], "width": [0, 0, 0, 0], "strand": ["+", "-", "*", "*"], "seqinfo": {"$ref": "si"}},
    "uq": {"$type": "GRanges", "seqnames": ["chr1", "chr2"], "start": [1, 1], "width": [2, 2], "strand": ["+", "-"], "seqinfo": {"$ref": "si"}},
    "us": {"$type": "GRanges", "seqnames": ["chr1", "chr2", "chr1"], "start": [2, 1, 500], "width": [2, 5, 2], "strand": ["+", "-", "+"], "seqinfo": {"$ref": "si"}}
  },
