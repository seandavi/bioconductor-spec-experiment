    "IR.SETDIFF": "setdiff(x, y) returns the positions covered by x and not y as reduced ranges",
    "IR.SETOPS.EDGE": "set operations with empty or zero-width inputs",
    "IR.PUNION": "punion(x, y) pairs ranges by position and returns the smallest range covering both; non-overlapping, non-adjacent pairs are an error unless fill.gap=TRUE",
    "IR.PINTERSECT": "pintersect(x, y) pairs ranges by position and returns their intersection; empty intersections follow resolve.empty",
    "IR.PSETDIFF": "psetdiff(x, y) pairs ranges by position and returns x minus y per pair; a y strictly inside x (would split it) is an error",
    "IR.PSETOPS.LEN": "parallel operations do not recycle: any length mismatch (including length 1) is an error"
  },
