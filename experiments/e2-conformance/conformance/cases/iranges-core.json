{
  "group": "iranges-core",
  "clauses": {
    "IR.MCOLS.LISTFACTOR": "metadata columns may be an IntegerList (values kept as written) or a factor (levels and NA kept); both survive mcols<-, mcols, [ and c",
    "IR.C.MCOLS.TYPES": "c() widens metadata column types to a common type (integer + double -> double, in either argument order); values are never truncated",
    "IR.CTOR.SW": "IRanges(start, width) builds ranges with end = start + width - 1",
    "IR.CTOR.SE": "IRanges(start, end) derives width = end - start + 1; the second positional argument is end",
    "IR.CTOR.EW": "IRanges(end, width) derives start = end - width + 1",
    "IR.CTOR.ZERO": "zero-width ranges are legal (width 0, end = start - 1) and keep their start",
    "IR.CTOR.NAMES": "names given to the constructor are kept verbatim, NA allowed; names shorter than the ranges are padded with NA",
    "IR.CTOR.RECYCLE": "length-1 start/width/end recycle against longer arguments; double input is coerced to integer by truncation toward zero",
    "IR.CTOR.EMPTY": "an empty IRanges has length 0 and empty start/width",
    "IR.CTOR.ERR": "negative width, end < start - 1, inconsistent start/end/width, and NA start/width are errors",
    "IR.ACC": "start, end, width, names and length read back the stored ranges",
    "IR.SUBSET.INT": "x[i] with positive i selects in order (repeats allowed); negative i drops; 0 is ignored; out-of-range is an error",
    "IR.SUBSET.LGL": "x[lgl] keeps TRUE positions; a shorter logical recycles",
    "IR.SUBSET.NAMES": "x[chr] selects by name in the order given; unknown names are an error",
    "IR.SUBSET.MCOLS": "subsetting subsets names and mcols rows together",
    "IR.C": "c(x, y, ...) concatenates ranges, names and mcols in order",
    "IR.MCOLS": "mcols is NULL for none; setting mcols stores a row-aligned DFrame; zero-width ranges may carry mcols"
  },
