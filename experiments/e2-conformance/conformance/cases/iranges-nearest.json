{
  "group": "iranges-nearest",
  "compare": "hits-query-grouped",
  "clauses": {
    "IR.NEAREST.ANY": "nearest(x, subject) returns, per query, the 1-based index of the closest subject; overlapping subjects are distance 0; NA when subject is empty",
    "IR.NEAREST.ALL": "nearest(select='all') returns Hits with every subject tied at the minimum distance",
    "IR.NEAREST.TIES": "with select='arbitrary' and tied subjects R picks one (pinned only where unambiguous); ties between subjects at equal distance are all returned by select='all'",
    "IR.NEAREST.SELF": "nearest(x) with no subject finds the nearest other range in x (never itself)",
    "IR.PRECEDE": "precede(x, subject) returns the subject starting strictly after end(x) with the smallest start; select='first' (default) picks lowest index among ties, 'all' returns all, 'last' is an error; NA if none",
    "IR.FOLLOW": "follow(x, subject) returns the subject ending strictly before start(x) with the largest end; select='last' (default) picks highest index among ties, 'all' returns all, 'first' is an error",
    "IR.DISTANCE": "distance(x, y) is parallel: 0 for overlapping or adjacent ranges, otherwise the number of positions strictly between them; the shorter argument recycles to the longer length (warning if not a multiple); names are dropped"
  },
