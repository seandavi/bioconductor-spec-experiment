{
  "group": "granges-core",
  "clauses": {
    "GR.MCOLS.LISTFACTOR": "IntegerList and factor metadata columns survive GRanges subsetting and combining",
    "GR.C.MCOLS.TYPES": "c() widens metadata column types to a common type (integer + double -> double, in either argument order); values are never truncated",
    "GR.CTOR": "GRanges(seqnames, ranges, strand) builds one range per element; strand defaults to '*'; levels default to the unique seqnames in order of first appearance",
    "GR.CTOR.STRAND": "strand accepts '+', '-', '*' (a length-1 strand recycles); NA becomes '*'; other values are errors",
    "GR.CTOR.SEQINFO": "an explicit seqinfo/seqlengths fixes level order and metadata; a seqname outside the levels is an error; levels may be unused",
    "GR.CTOR.META": "range names come from names(ranges); extra named arguments become mcols columns (so names= is a column, not range names)",
    "GR.CTOR.ERR": "length mismatches between seqnames/ranges/strand are errors (length-1 recycles)",
    "GR.ACC": "seqnames/strand return factor Rles in range order; ranges, start, end, width, names, length, seqinfo accessors read back stored values",
    "GR.SUBSET": "x[i] subsets seqnames, ranges, strand, names and mcols together, always keeping the full seqinfo",
    "GR.C": "c(x, y, ...) concatenates; seqinfo is merged (levels: x's order then new ones); incompatible seqinfo is an error; mcols columns are unioned with NA fill",
    "GR.SEQINFO.SET": "seqlevels<-, seqlengths<-, isCircular<-, genome<- and seqinfo<- change the seqinfo; dropping a level that is in use is an error; renaming and reordering relabel the data",
    "GR.TRIM": "trim(x) clips ranges to 1..seqlength on non-circular sequences with known length; ranges entirely outside become zero-width at the boundary; unknown lengths and circular sequences are untouched",
    "GR.MCOLS": "mcols(x) is always a DFrame with one row per range (zero columns when none); mcols<- replaces it, recycling a shorter DFrame cyclically (even when its rows do not divide the length)"
  },
