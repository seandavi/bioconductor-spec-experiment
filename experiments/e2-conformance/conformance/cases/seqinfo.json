{
  "group": "seqinfo",
  "clauses": {
    "SI.CTOR": "Seqinfo(seqnames, seqlengths, isCircular, genome) stores per-level metadata; omitted fields are NA; scalar genome recycles; seqnames must be unique and non-NA",
    "SI.ACC": "seqnames/seqlevels, seqlengths, isCircular, genome and length read back the stored values in level order",
    "SI.SUBSET": "si[names] selects and reorders levels by name; an unknown name adds a new level with NA metadata; integer and logical subscripts are errors",
    "SI.MERGE": "merge(x, y) unions levels (x's order first, then y's new levels); NA fields are filled from the other side; equal fields are kept",
    "SI.MERGE.CONFLICT": "merge errors when a level's seqlength, isCircular or genome differs (both non-NA) between x and y",
    "SI.REPLACE": "seqlevels<-, seqlengths<-, isCircular<-, genome<- replace values; renaming and dropping levels follow R's rules"
  },
  "fixtures": {
    "a": {"$type": "Seqinfo", "seqnames": ["chr1", "chr2", "chrM"], "seqlengths": {"$int": [1000, 500, 16]},
          "isCircular": [false, false, true], "genome": "hg"},
    "b": {"$type": "Seqinfo", "seqnames": ["chr2", "chr3", "chr1"], "seqlengths": {"$int": [500, 300, null]},
          "isCircular": {"$lgl": [null, false, null]}, "genome": {"$chr": [null, "hg", "hg"]}},
    "plain": {"$type": "Seqinfo", "seqnames": ["x", "y"]},
    "badlen": {"$type": "Seqinfo", "seqnames": ["chr1"], "seqlengths": {"$int": [999]}},
    "badgenome": {"$type": "Seqinfo", "seqnames": ["chr1"], "genome": "mm"},
    "badcirc": {"$type": "Seqinfo", "seqnames": ["chrM"], "isCircular": true},
    "emptysi": {"$type": "Seqinfo", "seqnames": {"$chr": []}}
  },
  "cases": [
    {"id": "si.ctor.names-only", "clause": "SI.CTOR", "op": "Seqinfo", "args": [], "kwargs": {"seqnames": ["a", "b", "c"]}},
    {"id": "si.ctor.full", "clause": "SI.CTOR", "op": "Seqinfo", "args": [], "kwargs": {"seqnames": ["a", "b"], "seqlengths": [10, 20], "isCircular": [true, false], "genome": ["g1", "g2"]}},
    {"id": "si.ctor.scalar-genome", "clause": "SI.CTOR", "op": "Seqinfo", "args": [], "kwargs": {"seqnames": ["a", "b"], "genome": "hg19"}},
    {"id": "si.ctor.partial-na", "clause": "SI.CTOR", "op": "Seqinfo", "args": [], "kwargs": {"seqnames": ["a", "b"], "seqlengths": {"$int": [5, null]}, "isCircular": {"$lgl": [null, true]}}},
    {"id": "si.ctor.double-lengths", "clause": "SI.CTOR", "op": "Seqinfo", "args": [], "kwargs": {"seqnames": ["a", "b"], "seqlengths": [5.0, 6.0]}},
    {"id": "si.ctor.empty", "clause": "SI.CTOR", "op": "Seqinfo", "args": [], "kwargs": {}},
    {"id": "si.ctor.err.dup", "clause": "SI.CTOR", "op": "Seqinfo", "args": [], "kwargs": {"seqnames": ["a", "a"]}},
    {"id": "si.ctor.err.na-name", "clause": "SI.CTOR", "op": "Seqinfo", "args": [], "kwargs": {"seqnames": {"$chr": ["a", null]}}},
    {"id": "si.ctor.err.neg-length", "clause": "SI.CTOR", "op": "Seqinfo", "args": [], "kwargs": {"seqnames": ["a"], "seqlengths": [-1]}},
    {"id": "si.ctor.err.length-mismatch", "clause": "SI.CTOR", "op": "Seqinfo", "args": [], "kwargs": {"seqnames": ["a", "b"], "seqlengths": [1, 2, 3]}},
    {"id": "si.acc.seqnames", "clause": "SI.ACC", "op": "seqnames", "args": [{"$ref": "a"}], "kwargs": {}},
    {"id": "si.acc.seqlevels", "clause": "SI.ACC", "op": "seqlevels", "args": [{"$ref": "a"}], "kwargs": {}},
    {"id": "si.acc.seqlengths", "clause": "SI.ACC", "op": "seqlengths", "args": [{"$ref": "a"}], "kwargs": {}},
    {"id": "si.acc.isCircular", "clause": "SI.ACC", "op": "isCircular", "args": [{"$ref": "a"}], "kwargs": {}},
    {"id": "si.acc.genome", "clause": "SI.ACC", "op": "genome", "args": [{"$ref": "a"}], "kwargs": {}},
    {"id": "si.acc.length", "clause": "SI.ACC", "op": "length", "args": [{"$ref": "a"}], "kwargs": {}},
    {"id": "si.acc.na-fields", "clause": "SI.ACC", "op": "seqlengths", "args": [{"$ref": "b"}], "kwargs": {}},
    {"id": "si.acc.na-genome", "clause": "SI.ACC", "op": "genome", "args": [{"$ref": "b"}], "kwargs": {}},
    {"id": "si.acc.na-circular", "clause": "SI.ACC", "op": "isCircular", "args": [{"$ref": "b"}], "kwargs": {}},
    {"id": "si.acc.plain-all-na", "clause": "SI.ACC", "op": "isCircular", "args": [{"$ref": "plain"}], "kwargs": {}},
    {"id": "si.acc.empty-length", "clause": "SI.ACC", "op": "length", "args": [{"$ref": "emptysi"}], "kwargs": {}},
    {"id": "si.subset.names", "clause": "SI.SUBSET", "op": "[", "args": [{"$ref": "a"}, ["chrM", "chr1"]], "kwargs": {}},
    {"id": "si.subset.err.int", "clause": "SI.SUBSET", "op": "[", "args": [{"$ref": "a"}, [3, 2]], "kwargs": {}},
    {"id": "si.subset.err.lgl", "clause": "SI.SUBSET", "op": "[", "args": [{"$ref": "a"}, [true, false, true]], "kwargs": {}},
    {"id": "si.subset.unknown-name-adds-level", "clause": "SI.SUBSET", "op": "[", "args": [{"$ref": "a"}, ["nope"]], "kwargs": {}},
    {"id": "si.merge.a-b", "clause": "SI.MERGE", "op": "merge", "args": [{"$ref": "a"}, {"$ref": "b"}], "kwargs": {}},
    {"id": "si.merge.b-a", "clause": "SI.MERGE", "op": "merge", "args": [{"$ref": "b"}, {"$ref": "a"}], "kwargs": {}},
    {"id": "si.merge.disjoint", "clause": "SI.MERGE", "op": "merge", "args": [{"$ref": "a"}, {"$ref": "plain"}], "kwargs": {}},
    {"id": "si.merge.self", "clause": "SI.MERGE", "op": "merge", "args": [{"$ref": "a"}, {"$ref": "a"}], "kwargs": {}},
    {"id": "si.merge.with-empty", "clause": "SI.MERGE", "op": "merge", "args": [{"$ref": "a"}, {"$ref": "emptysi"}], "kwargs": {}},
    {"id": "si.merge.fills-na", "clause": "SI.MERGE", "op": "merge", "args": [{"$ref": "badlen"}, {"$type": "Seqinfo", "seqnames": ["chr1"]}], "kwargs": {}},
    {"id": "si.merge.genome-na-with-set", "clause": "SI.MERGE", "op": "merge", "args": [{"$type": "Seqinfo", "seqnames": ["chr1"]}, {"$ref": "badgenome"}], "kwargs": {}},
    {"id": "si.merge.err.seqlength", "clause": "SI.MERGE.CONFLICT", "op": "merge", "args": [{"$ref": "a"}, {"$ref": "badlen"}], "kwargs": {}},
    {"id": "si.merge.err.genome", "clause": "SI.MERGE.CONFLICT", "op": "merge", "args": [{"$ref": "a"}, {"$ref": "badgenome"}], "kwargs": {}},
    {"id": "si.merge.err.circular", "clause": "SI.MERGE.CONFLICT", "op": "merge", "args": [{"$ref": "a"}, {"$type": "Seqinfo", "seqnames": ["chr1"], "isCircular": true}], "kwargs": {}},
    {"id": "si.merge.err.circular-m", "clause": "SI.MERGE.CONFLICT", "op": "merge", "args": [{"$ref": "a"}, {"$type": "Seqinfo", "seqnames": ["chrM"], "isCircular": false}], "kwargs": {}},
    {"id": "si.replace.seqlengths", "clause": "SI.REPLACE", "op": "seqlengths<-", "args": [{"$ref": "plain"}], "kwargs": {"value": [10, 20]}},
    {"id": "si.replace.seqlengths.named", "clause": "SI.REPLACE", "op": "seqlengths<-", "args": [{"$ref": "plain"}], "kwargs": {"value": {"$int": [20, 10], "names": ["y", "x"]}}},
    {"id": "si.replace.isCircular", "clause": "SI.REPLACE", "op": "isCircular<-", "args": [{"$ref": "plain"}], "kwargs": {"value": [true, false]}},
    {"id": "si.replace.genome", "clause": "SI.REPLACE", "op": "genome<-", "args": [{"$ref": "plain"}], "kwargs": {"value": "hg38"}},
    {"id": "si.replace.seqlevels.rename", "clause": "SI.REPLACE", "op": "seqlevels<-", "args": [{"$ref": "a"}], "kwargs": {"value": ["c1", "c2", "cM"]}},
    {"id": "si.replace.seqlevels.reorder", "clause": "SI.REPLACE", "op": "seqlevels<-", "args": [{"$ref": "a"}], "kwargs": {"value": {"$chr": ["chrM", "chr1", "chr2"]}}},
    {"id": "si.replace.seqlevels.drop", "clause": "SI.REPLACE", "op": "seqlevels<-", "args": [{"$ref": "a"}], "kwargs": {"value": ["chr1", "chrM"]}},
    {"id": "si.replace.seqlevels.add", "clause": "SI.REPLACE", "op": "seqlevels<-", "args": [{"$ref": "a"}], "kwargs": {"value": ["chr1", "chr2", "chrM", "chrX"]}},
    {"id": "si.replace.seqlengths.err.badlen", "clause": "SI.REPLACE", "op": "seqlengths<-", "args": [{"$ref": "plain"}], "kwargs": {"value": [1, 2, 3]}}
  ]
}
