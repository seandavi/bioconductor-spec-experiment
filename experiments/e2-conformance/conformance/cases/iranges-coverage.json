    {"id": "ir.cov.weight.whole-double", "clause": "IR.COV.WEIGHT", "op": "coverage", "args": [{"$ref": "xn"}], "kwargs": {"weight": 2.0}},
    {"id": "ir.cov.weight.recycle", "clause": "IR.COV.WEIGHT", "op": "coverage", "args": [{"$ref": "adj"}], "kwargs": {"weight": [1, 10]}},
    {"id": "ir.cov.empty", "clause": "IR.COV.EDGE", "op": "coverage", "args": [{"$ref": "e"}], "kwargs": {}},
    {"id": "ir.cov.empty.width", "clause": "IR.COV.EDGE", "op": "coverage", "args": [{"$ref": "e"}], "kwargs": {"width": 5}},
    {"id": "ir.cov.zero-width-only", "clause": "IR.COV.EDGE", "op": "coverage", "args": [{"$ref": "z"}], "kwargs": {}},
    {"id": "ir.cov.zero-width-only.width", "clause": "IR.COV.EDGE", "op": "coverage", "args": [{"$ref": "z"}], "kwargs": {"width": 6}},
    {"id": "ir.cov.err.width-neg", "clause": "IR.COV.ERR", "op": "coverage", "args": [{"$ref": "x"}], "kwargs": {"width": -1}},
    {"id": "ir.cov.err.weight-len", "clause": "IR.COV.ERR", "op": "coverage", "args": [{"$ref": "adj"}], "kwargs": {"weight": [1, 2, 3, 4]}}
  ]
}
