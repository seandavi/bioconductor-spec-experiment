    {"id": "gr.gaps.strand-mix", "clause": "GR.GAPS", "op": "gaps", "args": [{"$ref": "gs"}], "kwargs": {}},
    {"id": "gr.gaps.empty", "clause": "GR.GAPS", "op": "gaps", "args": [{"$ref": "ge"}], "kwargs": {}},
    {"id": "gr.gaps.no-seqlengths", "clause": "GR.GAPS", "op": "gaps", "args": [{"$ref": "gn"}], "kwargs": {}},
    {"id": "gr.gaps.start", "clause": "GR.GAPS.ARGS", "op": "gaps", "args": [{"$ref": "ga"}], "kwargs": {"start": 3}},
    {"id": "gr.gaps.end", "clause": "GR.GAPS.ARGS", "op": "gaps", "args": [{"$ref": "ga"}], "kwargs": {"end": 25}},
    {"id": "gr.gaps.start-end", "clause": "GR.GAPS.ARGS", "op": "gaps", "args": [{"$ref": "ga"}], "kwargs": {"start": 3, "end": 25}},
    {"id": "gr.gaps.end-named", "clause": "GR.GAPS.ARGS", "op": "gaps", "args": [{"$ref": "ga"}], "kwargs": {"end": {"$int": [50, 20, 10, 5], "names": ["chr1", "chr2", "chrX", "chrU"]}}},
    {"id": "gr.gaps.end-unnamed-vector", "clause": "GR.GAPS.ARGS", "op": "gaps", "args": [{"$ref": "ga"}], "kwargs": {"end": [50, 20, 10, 5]}},
    {"id": "gr.gaps.end-unnamed-short", "clause": "GR.GAPS.ARGS", "op": "gaps", "args": [{"$ref": "ga"}], "kwargs": {"end": [50, 20]}},
    {"id": "gr.gaps.start-vector", "clause": "GR.GAPS.ARGS", "op": "gaps", "args": [{"$ref": "ga"}], "kwargs": {"start": [1, 5, 10, 20]}},
