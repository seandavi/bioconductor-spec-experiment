    {"id": "gr.reduce.strand-order", "clause": "GR.REDUCE", "op": "reduce", "args": [{"$ref": "gs"}], "kwargs": {}},
    {"id": "gr.reduce.no-seqinfo", "clause": "GR.REDUCE", "op": "reduce", "args": [{"$ref": "gn"}], "kwargs": {}},
    {"id": "gr.reduce.ignore-strand", "clause": "GR.REDUCE.IGNORE", "op": "reduce", "args": [{"$ref": "g"}], "kwargs": {"ignore.strand": true}},
    {"id": "gr.reduce.ignore-strand.gs", "clause": "GR.REDUCE.IGNORE", "op": "reduce", "args": [{"$ref": "gs"}], "kwargs": {"ignore.strand": true}},
    {"id": "gr.reduce.mingap", "clause": "GR.REDUCE.OPTS", "op": "reduce", "args": [{"$ref": "g"}], "kwargs": {"min.gapwidth": 10}},
    {"id": "gr.reduce.mingap0", "clause": "GR.REDUCE.OPTS", "op": "reduce", "args": [{"$ref": "ga"}], "kwargs": {"min.gapwidth": 0}},
    {"id": "gr.reduce.drop-empty", "clause": "GR.REDUCE.OPTS", "op": "reduce", "args": [{"$ref": "g"}], "kwargs": {"drop.empty.ranges": true}},
    {"id": "gr.reduce.revmap", "clause": "GR.REDUCE.OPTS", "op": "reduce", "args": [{"$ref": "g"}], "kwargs": {"with.revmap": true}},
