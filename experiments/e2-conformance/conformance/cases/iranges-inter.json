    "IR.REDUCE.MINGAP": "reduce merges ranges whose gap is < min.gapwidth; min.gapwidth=0 keeps adjacent ranges apart",
    "IR.REDUCE.EMPTY": "drop.empty.ranges=FALSE keeps zero-width ranges that are not absorbed; TRUE removes them",
    "IR.REDUCE.REVMAP": "with.revmap=TRUE adds mcols$revmap, an IntegerList of 1-based input indices per output range",
    "IR.GAPS": "gaps(x, start, end) returns the uncovered positions between start and end (default: from min start to max end)",
    "IR.GAPS.EDGE": "gaps with start/end outside the ranges, empty input, or fully covering input",
    "IR.DISJOIN": "disjoin splits ranges into the unique non-overlapping pieces, sorted, dropping zero-width input; with.revmap lists contributing inputs"
  },
