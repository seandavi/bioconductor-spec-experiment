{
  "group": "granges-intra",
  "clauses": {
    "GR.SHIFT": "shift(x, s) moves ranges by s regardless of strand, keeping seqnames, strand, names, mcols and seqinfo",
    "GR.NARROW": "narrow(x, start, end, width) trims relative to each range's own coordinates, independent of strand",
    "GR.RESIZE": "resize(x, w, fix) is strand-aware: fix='start' keeps the 5' end (start on +/*, end on -), fix='end' the 3' end; 'center' is strand-independent; ignore.strand=TRUE treats every range as '+'",
    "GR.FLANK": "flank(x, w, start, both) is strand-aware: start=TRUE flanks the 5' side (upstream; left on +/*, right on -); ignore.strand=TRUE treats every range as '+'",
    "GR.PROMOTERS": "promoters(x, upstream, downstream) is strand-aware: on '-' the window lies to the right of end(x); '*' behaves like '+'",
    "GR.INTRA.OOB": "results extending beyond seqlengths are returned untrimmed (with a warning)",
    "GR.INTRA.META": "intra-range ops keep names, mcols, strand and the full seqinfo",
    "GR.INTRA.ERR": "invalid arguments (negative widths, NA) are errors"
  },
