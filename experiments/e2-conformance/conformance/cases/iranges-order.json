{
  "group": "iranges-order",
  "clauses": {
    "IR.ORDER": "order(x) sorts by start, then width (ascending); ties keep input order (stable); decreasing=TRUE reverses the key order but ties still keep input order",
    "IR.SORT": "sort(x) = x[order(x)]: names and mcols travel with their ranges; decreasing=TRUE supported",
    "IR.RANK": "rank(x, ties.method=m) ranks ranges in the order of IR.ORDER; ties follow base R (average gives doubles, others integers); names are dropped",
    "IR.DUP": "duplicated(x) flags ranges identical in start and width to an earlier one (fromLast flips); names and mcols are ignored",
    "IR.UNIQUE": "unique(x) keeps the first (fromLast: last) of each distinct (start, width), in input order, keeping names/mcols of the kept element",
    "IR.ORDER.ERR": "rank(x) without an explicit ties.method is an error for IRanges (R quirk); unsupported ties.method values are errors"
  },
  "fixtures": {
    "x": {"$type": "IRanges", "start": [10, 3, 10, 3, 7, 10, 3, 5], "width": [2, 4, 5, 4, 0, 2, 1, 0],
          "names": ["a", "b", "c", "d", "e", "f", "g", "h"],
          "mcols": {"$type": "DFrame", "columns": {"i": [1, 2, 3, 4, 5, 6, 7, 8]}}},
    "y": {"$type": "IRanges", "start": [10, 3, 10, 3, 7, 10, 3, 5], "width": [2, 4, 5, 4, 0, 2, 1, 0]},
    "e": {"$type": "IRanges", "start": {"$int": []}, "width": {"$int": []}},
    "u": {"$type": "IRanges", "start": [5, 1, 9], "width": [1, 1, 1]},
    "neg": {"$type": "IRanges", "start": [-5, 0, 5, -5], "width": [3, 2, 1, 1]}
  },
  "cases": [
