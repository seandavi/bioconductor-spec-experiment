{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "bioc-spec-eval/projection.schema.json",
  "title": "Normalized result projection (R conventions). Semantics: PROJECTION.md",
  "$ref": "#/$defs/projection",
  "$defs": {
    "int": {"type": ["integer", "null"]},
    "dbl": {"oneOf": [{"type": "number"}, {"enum": ["NaN", "Inf", "-Inf"]}, {"type": "null"}]},
    "chr": {"type": ["string", "null"]},
    "lgl": {"type": ["boolean", "null"]},
    "ints": {"type": "array", "items": {"type": "integer"}},
    "names": {"oneOf": [{"type": "null"}, {"type": "array", "items": {"$ref": "#/$defs/chr"}}]},
    "typed_values": {
      "oneOf": [
        {"properties": {"type": {"const": "int"}, "values": {"type": "array", "items": {"$ref": "#/$defs/int"}}}},
        {"properties": {"type": {"const": "dbl"}, "values": {"type": "array", "items": {"$ref": "#/$defs/dbl"}}}},
        {"properties": {"type": {"const": "chr"}, "values": {"type": "array", "items": {"$ref": "#/$defs/chr"}}}},
        {"properties": {"type": {"const": "lgl"}, "values": {"type": "array", "items": {"$ref": "#/$defs/lgl"}}}}
      ]
    },
    "vector": {
      "type": "object",
      "required": ["kind", "type", "values", "names"],
      "additionalProperties": false,
      "properties": {"kind": {"const": "vector"}, "type": {"enum": ["int", "dbl", "chr", "lgl"]}, "values": {"type": "array"}, "names": {"$ref": "#/$defs/names"}},
      "$ref": "#/$defs/typed_values"
    },
    "null": {"type": "object", "required": ["kind"], "additionalProperties": false, "properties": {"kind": {"const": "NULL"}}},
    "factor": {
      "type": "object", "required": ["kind", "levels", "codes"], "additionalProperties": false,
      "properties": {"kind": {"const": "Factor"}, "levels": {"type": "array", "items": {"type": "string"}}, "codes": {"type": "array", "items": {"type": ["integer", "null"], "minimum": 1}}}
    },
    "integerlist": {
      "type": "object", "required": ["kind", "elements", "names"], "additionalProperties": false,
      "properties": {"kind": {"const": "IntegerList"}, "elements": {"type": "array", "items": {"type": "array", "items": {"$ref": "#/$defs/int"}}}, "names": {"$ref": "#/$defs/names"}}
    },
    "columns": {
      "type": "array",
      "items": {
        "type": "array", "minItems": 2, "maxItems": 2,
        "prefixItems": [{"type": "string"}, {"oneOf": [{"$ref": "#/$defs/vector"}, {"$ref": "#/$defs/factor"}, {"$ref": "#/$defs/integerlist"}]}]
      }
    },
    "seqinfo": {
      "type": "object", "required": ["kind", "seqnames", "seqlengths", "isCircular", "genome"], "additionalProperties": false,
      "properties": {
        "kind": {"const": "Seqinfo"},
        "seqnames": {"type": "array", "items": {"type": "string"}},
        "seqlengths": {"type": "array", "items": {"$ref": "#/$defs/int"}},
        "isCircular": {"type": "array", "items": {"$ref": "#/$defs/lgl"}},
        "genome": {"type": "array", "items": {"$ref": "#/$defs/chr"}}
      }
    },
    "iranges": {
      "type": "object", "required": ["kind", "start", "width", "names", "mcols"], "additionalProperties": false,
      "properties": {"kind": {"const": "IRanges"}, "start": {"$ref": "#/$defs/ints"}, "width": {"$ref": "#/$defs/ints"}, "names": {"$ref": "#/$defs/names"}, "mcols": {"$ref": "#/$defs/columns"}}
    },
    "granges": {
      "type": "object", "required": ["kind", "seqnames", "start", "width", "strand", "names", "mcols", "seqinfo"], "additionalProperties": false,
      "properties": {
        "kind": {"const": "GRanges"},
        "seqnames": {"type": "array", "items": {"type": "string"}},
        "start": {"$ref": "#/$defs/ints"},
        "width": {"$ref": "#/$defs/ints"},
        "strand": {"type": "array", "items": {"enum": ["+", "-", "*"]}},
        "names": {"$ref": "#/$defs/names"},
        "mcols": {"$ref": "#/$defs/columns"},
        "seqinfo": {"$ref": "#/$defs/seqinfo"}
      }
    },
    "dataframe": {
      "type": "object", "required": ["kind", "nrow", "rownames", "columns"], "additionalProperties": false,
      "properties": {"kind": {"const": "DataFrame"}, "nrow": {"type": "integer", "minimum": 0}, "rownames": {"$ref": "#/$defs/names"}, "columns": {"$ref": "#/$defs/columns"}}
    },
    "hits": {
      "type": "object", "required": ["kind", "from", "to", "nLnode", "nRnode"], "additionalProperties": false,
      "properties": {
        "kind": {"const": "Hits"},
        "from": {"type": "array", "items": {"type": "integer", "minimum": 1}},
        "to": {"type": "array", "items": {"type": "integer", "minimum": 1}},
        "nLnode": {"type": "integer", "minimum": 0},
        "nRnode": {"type": "integer", "minimum": 0}
      }
    },
    "rle_body": {
      "type": "object", "required": ["type", "values", "lengths"],
      "properties": {"type": {"enum": ["int", "dbl", "lgl"]}, "values": {"type": "array"}, "lengths": {"type": "array", "items": {"type": "integer", "minimum": 1}}},
      "$ref": "#/$defs/typed_values"
    },
    "rle": {
      "type": "object", "required": ["kind", "type", "values", "lengths"], "additionalProperties": false,
      "properties": {"kind": {"const": "Rle"}, "type": true, "values": true, "lengths": true},
      "$ref": "#/$defs/rle_body"
    },
    "rlelist": {
      "type": "object", "required": ["kind", "names", "elements"], "additionalProperties": false,
      "properties": {
        "kind": {"const": "RleList"},
        "names": {"$ref": "#/$defs/names"},
        "elements": {"type": "array", "items": {"allOf": [{"$ref": "#/$defs/rle_body"}, {"type": "object", "additionalProperties": false, "properties": {"type": true, "values": true, "lengths": true}}]}}
      }
    },
    "error": {
      "type": "object", "required": ["kind", "message"], "additionalProperties": false,
      "properties": {"kind": {"const": "error"}, "message": {"type": "string"}, "type": {"type": "string"}}
    },
    "projection": {
      "oneOf": [
        {"$ref": "#/$defs/vector"}, {"$ref": "#/$defs/null"}, {"$ref": "#/$defs/iranges"}, {"$ref": "#/$defs/granges"},
        {"$ref": "#/$defs/seqinfo"}, {"$ref": "#/$defs/dataframe"}, {"$ref": "#/$defs/factor"}, {"$ref": "#/$defs/integerlist"},
        {"$ref": "#/$defs/hits"}, {"$ref": "#/$defs/rle"}, {"$ref": "#/$defs/rlelist"}, {"$ref": "#/$defs/error"}
      ]
    }
  }
}
